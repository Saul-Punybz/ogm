# Sin DATABASE_URL la app usa una base local en .data/ (PGlite). Para produccion,
# pon aqui la cadena de Neon/Vercel Postgres y corre `npm run setup`.
# DATABASE_URL=postgres://usuario:clave@host/base?sslmode=require

# Clave del panel de admin. Cambiala antes de publicar.
ADMIN_PASSWORD=ogm2026

# Login con Discord. Crear la app en https://discord.com/developers/applications
# y poner como redirect: <APP_URL>/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
APP_URL=http://localhost:3000

# Secreto para firmar la sesion. En produccion es obligatorio: `openssl rand -base64 32`
AUTH_SECRET=

# IDs de Discord con acceso al panel de admin, separados por coma.
ADMIN_DISCORD_IDS=

# Canales y contacto. Si no se ponen, el sitio dice "por anunciar" en vez de inventar.
OGM_KICK_URL=
OGM_TWITCH_URL=
OGM_DISCORD_INVITE=
OGM_CONTACT_EMAIL=
